.DS_Store

# .claude/ — local by default. Track only project-shared config.
.claude/*
!.claude/rules/
!.claude/agents/
!.claude/agent-memory/
!.claude/scripts/
!.claude/settings.json
!.claude/skills/

# Skills: only the bundled code-documentation skill is tracked.
.claude/skills/*
!.claude/skills/code-documentation/

# Never track agent-generated audit reports under any skill.
.claude/skills/*/audits/
.codex/
.cursor/
.npm-cache/
dist/
.agents/
node_modules/

# Wrangler
.wrangler/
packages/*/.wrangler/

# Monorepo
.turbo/
apps/*/.turbo/
packages/*/.turbo/
apps/*/dist/
apps/*/node_modules/
packages/*/dist/
packages/*/node_modules/

tmp/
