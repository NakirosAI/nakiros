    { "id": "frontmatter.user_invocable",     "section": "frontmatter", "label": "user-invocable set correctly",                              "severityIfFail": "warn",    "findingCode": "USER_INVOCABLE_WRONG" },
    { "id": "frontmatter.no_extra_fields",    "section": "frontmatter", "label": "no unnecessary frontmatter fields",                         "severityIfFail": "info",    "findingCode": "EXTRA_FIELDS" },

    { "id": "io.inputs_section",              "section": "io",          "label": "Inputs section with commands, args, files, external data",  "severityIfFail": "warn",    "findingCode": "INPUTS_MISSING" },
    { "id": "io.outputs_section",             "section": "io",          "label": "Outputs section with ALL files, side effects, chat",        "severityIfFail": "warn",    "findingCode": "OUTPUTS_MISSING" },
    { "id": "io.example_flow",                "section": "io",          "label": "at least one concrete input → output example flow",         "severityIfFail": "warn",    "findingCode": "NO_EXAMPLE_FLOW" },
    { "id": "io.output_paths_clear",          "section": "io",          "label": "output file paths use clear patterns",                      "severityIfFail": "info",    "findingCode": "OUTPUT_PATHS_VAGUE" },

    { "id": "structure.under_500_lines",      "section": "structure",   "label": "under 500 lines / ~5000 tokens",                            "severityIfFail": "warn",    "findingCode": "SKILL_TOO_LONG" },
    { "id": "structure.refs_externalized",    "section": "structure",   "label": "heavy reference material lives in references/",            "severityIfFail": "warn",    "findingCode": "REFS_INLINE" },
    { "id": "structure.context_loading",      "section": "structure",   "label": "context loading lists ALL files with WHEN conditions",      "severityIfFail": "warn",    "findingCode": "CONTEXT_LOADING_INCOMPLETE" },
    { "id": "structure.commands_at_bottom",   "section": "structure",   "label": "available commands listed at the bottom",                   "severityIfFail": "info",    "findingCode": "COMMANDS_MISSING" },

    { "id": "content.procedural",             "section": "content",     "label": "procedures, not declarations",                              "severityIfFail": "warn",    "findingCode": "DECLARATIVE" },
    { "id": "content.adds_what_lacks",        "section": "content",     "label": "adds what agent LACKS, omits what it KNOWS",                "severityIfFail": "info",    "findingCode": "REDUNDANT_CONTENT" },
    { "id": "content.defaults_not_menus",     "section": "content",     "label": "defaults, not menus",                                       "severityIfFail": "warn",    "findingCode": "MENU_INSTEAD_OF_DEFAULT" },
    { "id": "content.gotchas_section",        "section": "content",     "label": "gotchas section with project-specific traps",               "severityIfFail": "warn",    "findingCode": "GOTCHAS_MISSING" },
    { "id": "content.actionable",             "section": "content",     "label": "every instruction is specific and actionable",              "severityIfFail": "warn",    "findingCode": "VAGUE_INSTRUCTIONS" },

    { "id": "safety.no_mocks",                "section": "safety",      "label": "no mocks rule (when skill touches real infra)",             "severityIfFail": "critical","findingCode": "MOCKS_RULE_MISSING" },
    { "id": "safety.ask_when_unsure",         "section": "safety",      "label": "ASK when unsure rule",                                      "severityIfFail": "warn",    "findingCode": "ASK_RULE_MISSING" },
    { "id": "safety.auth_security",           "section": "safety",      "label": "auth/security context referenced when relevant",            "severityIfFail": "critical","findingCode": "AUTH_CONTEXT_MISSING" },

    { "id": "consistency.french_rule",        "section": "consistency", "label": "french communication rule present",                         "severityIfFail": "info",    "findingCode": "FRENCH_RULE_MISSING" },
    { "id": "consistency.paths_match",        "section": "consistency", "label": "file paths match current project structure",                "severityIfFail": "warn",    "findingCode": "INVALID_PATHS" },
    { "id": "consistency.llm_docs",           "section": "consistency", "label": "LLM docs referenced when using specific frameworks",        "severityIfFail": "info",    "findingCode": "LLM_DOCS_MISSING" }
  ]
