    { "id": "structure",    "label": "Structure",        "checks": ["structure.under_500_lines", "structure.refs_externalized", "structure.context_loading", "structure.commands_at_bottom"] },
    { "id": "content",      "label": "Content",          "checks": ["content.procedural", "content.adds_what_lacks", "content.defaults_not_menus", "content.gotchas_section", "content.actionable"] },
    { "id": "safety",       "label": "Safety",           "checks": ["safety.no_mocks", "safety.ask_when_unsure", "safety.auth_security"] },
